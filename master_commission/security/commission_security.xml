<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_master_commission" model="ir.module.category">
            <field name="name">Master Commission</field>
            <field name="description">Ayuda a gestionar el reparto de utilidades entre socios.</field>
            <field name="sequence">100</field>
        </record>

        <record id="group_commission_user" model="res.groups">
            <field name="name">Socio (Ver propias comisiones)</field>
            <field name="category_id" ref="module_category_master_commission"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_commission_admin" model="res.groups">
            <field name="name">Administrador (Ver todas)</field>
            <field name="category_id" ref="module_category_master_commission"/>
            <field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Reglas de Registro (Record Rules) -->
        <record id="commission_record_user_rule" model="ir.rule">
            <field name="name">Comisiones Propias Socio</field>
            <field name="model_id" ref="model_master_commission_record"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
        </record>

        <record id="commission_record_admin_rule" model="ir.rule">
            <field name="name">Todas las Comisiones Admin</field>
            <field name="model_id" ref="model_master_commission_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_commission_admin'))]"/>
        </record>
    </data>
</odoo>
