<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_commission" model="ir.ui.view">
        <field name="name">res.users.form.commission</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='access_rights']" position="inside">
                <group string="Master Commission">
                    <field name="is_commission_partner"/>
                    <field name="commission_weight" invisible="is_commission_partner == False"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
