<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_master_commission_liquidation_tree" model="ir.ui.view">
        <field name="name">master.commission.liquidation.tree</field>
        <field name="model">master.commission.liquidation</field>
        <field name="arch" type="xml">
            <list string="Liquidaciones">
                <field name="name"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="total_amount" sum="Total Pagado"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_master_commission_liquidation_form" model="ir.ui.view">
        <field name="name">master.commission.liquidation.form</field>
        <field name="model">master.commission.liquidation</field>
        <field name="arch" type="xml">
            <form string="Liquidación">
                <header>
                    <button name="action_mark_done" string="Marcar como Liquidada" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_mark_cancel" string="Cancelar" type="object" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comisiones Incluidas">
                            <field name="commission_ids" readonly="state != 'draft'">
                                <list>
                                    <field name="name"/>
                                    <field name="sale_order_id"/>
                                    <field name="partner_id"/>
                                    <field name="date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de Liquidaciones -->
    <record id="action_master_commission_liquidation" model="ir.actions.act_window">
        <field name="name">Liquidaciones de Fin de Mes</field>
        <field name="res_model">master.commission.liquidation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Acción de Servidor para agrupar en Liquidación -->
    <record id="action_generate_liquidation_from_records" model="ir.actions.server">
        <field name="name">Generar Liquidación</field>
        <field name="model_id" ref="model_master_commission_record"/>
        <field name="binding_model_id" ref="model_master_commission_record"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
records = records.filtered(lambda r: r.state == 'draft' and not r.liquidation_id)
if records:
    users = records.mapped('user_id')
    for user in users:
        user_records = records.filtered(lambda r: r.user_id == user)
        env['master.commission.liquidation'].create({
            'user_id': user.id,
            'commission_ids': [(6, 0, user_records.ids)]
        })
        ]]></field>
    </record>
</odoo>
