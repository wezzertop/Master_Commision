<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_commission" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.master_commission</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Master Commission" string="Master Commission" name="Master_Commision" groups="Master_Commision.group_commission_admin">
                    <block title="Configuración de Utilidades" name="utility_setting_container">
                        <setting string="Porcentaje por Defecto" help="Utilidad predeterminada para nuevas órdenes de venta.">
                            <field name="commission_default_percentage"/>
                        </setting>
                        <setting string="Base por Defecto" help="Calcular sobre el subtotal sin impuestos o el total con impuestos.">
                            <field name="commission_default_base_type"/>
                        </setting>
                        <setting string="Momento de Generación" help="Decide cuándo el sistema libera la comisión para los socios.">
                            <field name="commission_generation_trigger" widget="radio"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_master_commission_configuration" model="ir.actions.act_window">
        <field name="name">Ajustes</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'master_commission', 'bin_size': False}</field>
    </record>
</odoo>
